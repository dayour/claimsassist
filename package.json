{
  "name": "claim-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Claim_Studio — Workers' Comp Claims Tracker (Power Apps Code App)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:solution": "node scripts/validate-solution.mjs solution/ClaimStudio_unmanaged.zip",
    "validate:dataverse": "node scripts/validate-dataverse.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release:export": "node scripts/release.mjs --export"
  },
  "dependencies": {
    "@microsoft/power-apps": "^1.1.9",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
